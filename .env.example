# ─── Store v2 — Environment Configuration ────────────────────────────────────
# Copy this file to .env and fill in your values before starting the server.

PORT=3000

# If enabled, startup prevents duplicate server instances.
# "replace" = stop existing instance and start fresh
# "reuse"   = keep existing instance and exit new launch
STRICT_SINGLE_INSTANCE=false
SINGLE_INSTANCE_MODE=replace
INSTANCE_LOCK_FILENAME=server-instance.lock

# Number of fallback ports to try when PORT is already in use
PORT_RETRY_COUNT=20

# Public GET API caching for faster repeat loads on phones/laptops
API_CACHE_MAX_AGE=20
API_CACHE_STALE_SECONDS=120

# HTTP connection tuning for slower/flaky client networks
SERVER_KEEP_ALIVE_TIMEOUT_MS=65000
SERVER_HEADERS_TIMEOUT_MS=70000
SERVER_REQUEST_TIMEOUT_MS=120000

ADMIN_USER=admin
ADMIN_PASS=changeme123

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret-string

STORE_NAME=My Store
STORE_TAGLINE=Curated Collection
STORE_DESCRIPTION=Handpicked items, fair prices. Browse and discover something you'll love.
STORE_FOOTER=© 2025 My Store — All rights reserved

# Set to "true" when behind Tailscale Funnel or any reverse proxy
TRUST_PROXY=true

# ─── Square Payment Configuration ──────────────────────────────────────────────
# Get from https://developer.squareup.com/apps and your Square dashboard
SQUARE_ACCESS_TOKEN=sq_live_xxx_or_sq_sandbox_xxx
SQUARE_LOCATION_ID=L_xxxxx
SQUARE_APP_ID=sq_appid_xxx
SQUARE_WEBHOOK_SIGNATURE_KEY=xxxx
SQUARE_ENVIRONMENT=Sandbox
SQUARE_API_VERSION=2024-12-15

# Optional private order notifications
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFY_USER_ID=

# ─── Payment Methods & Features ────────────────────────────────────────────────
# Enable/disable specific payment methods
ENABLE_CARD_PAYMENTS=true
ENABLE_APPLE_PAY=true
ENABLE_GOOGLE_PAY=true

# ─── Order Notifications ──────────────────────────────────────────────────────
# Configure how customers are notified after successful purchase
#Most of this should be handled by square webhooks, but you can enable additional notifications if desired
# Email notifications (uses Nodemailer - requires email service config)
SEND_RECEIPT_EMAIL=true
EMAIL_SERVICE=gmail
EMAIL_FROM=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Or use SMTP directly
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SMS notifications (optional - uses Twilio)
SEND_ORDER_SMS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Payment Success Messages ────────────────────────────────────────────────
# Customize what customers see after payment
SUCCESS_MESSAGE_TITLE=Order Placed!
SUCCESS_MESSAGE_BODY=Thank you for your purchase. Your order has been confirmed and you'll receive updates via email.
SUCCESS_SHOW_ORDER_ID=true
SUCCESS_SHOW_RECEIPT_EMAIL=true

# Redirect URL after payment (optional)
# SUCCESS_REDIRECT_URL=https://example.com/thank-you
